# Use a separate PostgreSQL instance on 5433. Never copy legacy .env.
CRM_DATABASE_SCHEMA=thai
DATABASE_URL=postgresql://thai_crm_app:CHANGE_ME@127.0.0.1:5433/thai_crm
CRM_JWT_SECRET=GENERATE_A_SEPARATE_SECRET_OF_AT_LEAST_32_CHARACTERS
CRM_API_HOST=127.0.0.1
CRM_API_PORT=8001
CRM_API_CORS_ORIGINS=http://localhost:3001
# Optional. Dedicated new bot; comma-separated Telegram admin IDs.
BOT_TOKEN=
# TRON USDT address: fallback for /кош and /отпр; /setwallet persists an override.
# Existing watches retain the address captured when they were created.
USDT_WALLET=
ADMIN_IDS=
REQUEST_CHAT_ID=
# Administrative commands and /сообщение exports. ADMIN_CHAT_ID in this same file is supported.
ADMIN_CHAT_ID=
# XE converter; CONVERTER_API_* in this same file is also supported.
CONVERTER_API_BASE_URL=
CONVERTER_API_TOKEN=
# Archive only this bot's new incoming/outgoing messages; separate local media storage.
MESSAGE_ARCHIVE_ENABLED=true
MESSAGE_ARCHIVE_MEDIA_DIR=.runtime/message_archive/media
MESSAGE_ARCHIVE_TEMP_DIR=.runtime/message_archive/exports
# Optional Tronscan API key for rate limits/reliability; monitor needs a bot or key.
TRONSCAN_API_KEY=
# Telegram Login / OpenID Connect; Client Secret is separate from bot token.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Exact public origin, without path; register origin and callback in BotFather.
CRM_FRONTEND_ORIGIN=

# Existing chat structure in this same branch file. Does not create city accounts.
CASH_CHAT_ID=
CITY_SCHEDULE_CHATS=
CITY_CASH_CHAT_IDS=
BEST_CHANGE_CHAT_ID=
DANIYAR_CHAT=
GETBLOCK_IDENTITY=
GETBLOCK_PASSWORD=
GETBLOCK_USER_ID=
GETBLOCK_REPORTS_DIR=.runtime/aml_reports
