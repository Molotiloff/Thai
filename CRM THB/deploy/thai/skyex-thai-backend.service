[Unit]
Description=SkyEX Thai API and Telegram worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skyex-thai
Group=skyex-thai
WorkingDirectory=/opt/skyex-thai/current
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/skyex-thai/current/.venv/bin/python /opt/skyex-thai/current/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skyex-thai-backend

[Install]
WantedBy=multi-user.target
