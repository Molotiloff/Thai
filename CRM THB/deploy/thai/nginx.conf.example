# Install as /etc/nginx/sites-available/skyex-thai after issuing the certificate.
# Leave existing RF/default vhosts untouched. All browser routes belong to Next.js.
server {
    listen 80;
    server_name thai-crm.work.gd;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/skyex-thai-acme;
    }
    location / {
        return 301 https://thai-crm.work.gd$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name thai-crm.work.gd;
    ssl_certificate /etc/letsencrypt/live/thai-crm.work.gd/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/thai-crm.work.gd/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 2m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # /api/thai/*, /api/auth/* and /api/thai-logout are Next.js BFF routes.
    # Do not send the entire /api/ prefix straight to FastAPI.
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
