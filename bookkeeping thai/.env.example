# Отдельный API тайской CRM; российские CRM_* настройки не используются.
THAI_API_BASE_URL=http://127.0.0.1:8001/api/v1
# Запуск frontend на отдельном порту: pnpm dev --port 3001
# Публичные настройки отдельного Telegram Login тайской CRM (без Client Secret).
THAI_TELEGRAM_OIDC_CLIENT_ID=
THAI_FRONTEND_ORIGIN=
